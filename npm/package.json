{
  "name": "nosleepp",
  "version": "0.3.1",
  "description": "Keep your PC awake while AI agents are working",
  "preferGlobal": true,
  "bin": {
    "nosleepp": "./index.js"
  },
  "files": [
    "README.md",
    "index.js",
    "lib/resolve-binary.js",
    "lib/ensure-executable.js",
    "lib/postinstall.js",
    "bin/nosleepp-win32-x64.exe",
    "bin/nosleepp-darwin-arm64",
    "bin/nosleepp-darwin-x64",
    "bin/nosleepp-linux-x64",
    "bin/nosleepp-linux-arm64"
  ],
  "keywords": [
    "nosleepp",
